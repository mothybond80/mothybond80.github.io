# Copy to .env and fill in. Never commit .env.

# --- Google Maps Platform -------------------------------------------------
# Key needs: Places API (New), Routes API, Geocoding API.
# Restrict it to those three APIs.
GOOGLE_MAPS_API_KEY=

# Results are biased to this region / language. "uk" + "en-GB" + IMPERIAL gives miles.
GOOGLE_REGION=uk
GOOGLE_LANGUAGE=en-GB
GOOGLE_UNITS=IMPERIAL

# Optional "lat,lng" to bias place search, e.g. Rugby town centre. Helps short
# business names resolve to the local result.
GOOGLE_LOCATION_BIAS=52.3709,-1.2650
GOOGLE_LOCATION_BIAS_RADIUS_M=30000

# Used by get_directions when no origin is given (or origin is "current location").
# Leave blank to skip the distance/duration in that case; the Google Maps link
# then opens from the phone's live location.
DEFAULT_ORIGIN=

# --- Streamable HTTP server (claude.ai connector) -------------------------------
HOST=127.0.0.1
PORT=3460
# Bearer token claude.ai must send. Required if HOST is not a loopback address,
# strongly recommended always. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Retries / logging ---------------------------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=300
RETRY_MAX_DELAY_MS=5000
LOG_LEVEL=info
