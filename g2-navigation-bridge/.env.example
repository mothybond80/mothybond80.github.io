# Copy to .env and fill in. Never commit .env.

# --- Google Maps Platform -------------------------------------------------
# Key needs: Places API (New), Routes API, Geocoding API.
# Restrict it to those three APIs (and to your server IP if it has a fixed one).
GOOGLE_MAPS_API_KEY=

# Results are biased to this region / language. "uk" + "en-GB" + IMPERIAL gives miles.
GOOGLE_REGION=uk
GOOGLE_LANGUAGE=en-GB
GOOGLE_UNITS=IMPERIAL

# Optional "lat,lng" to bias place search, e.g. Rugby town centre. Helps short
# business names like "Tim Bond Dental" resolve to the local result.
GOOGLE_LOCATION_BIAS=52.3709,-1.2650
GOOGLE_LOCATION_BIAS_RADIUS_M=30000

# Used when the request has no origin, or origin is "current location".
# Leave blank to skip route calculation in that case: the Google Maps link
# then opens from the phone's live location.
DEFAULT_ORIGIN=

# --- G2 Navigation ----------------------------------------------------------
# mock      : nothing is sent; the payload is returned so you can inspect it (default)
# webhook   : POST the payload to G2_NAVIGATION_API_URL
# deep_link : build a link from G2_DEEP_LINK_TEMPLATE and return it; no HTTP call
G2_MODE=mock

# webhook mode. Must be https unless it is localhost / 127.0.0.1.
G2_NAVIGATION_API_URL=
G2_NAVIGATION_API_TOKEN=
G2_REQUEST_TIMEOUT_MS=10000

# deep_link mode. Placeholders: {lat} {lng} {name} {address} {place_id} {mode} {google_maps_link}
# Values are URL-encoded. Example only, NOT a real Even Realities scheme:
# G2_DEEP_LINK_TEMPLATE=evenhub-nav://navigate?lat={lat}&lng={lng}&name={name}
G2_DEEP_LINK_TEMPLATE=

# --- HTTP server --------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Bearer token callers must send to POST /navigate_to_g2.
# Required if HOST is anything other than a loopback address.
BRIDGE_API_TOKEN=

# --- Retries / logging ---------------------------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=300
RETRY_MAX_DELAY_MS=5000
LOG_LEVEL=info
