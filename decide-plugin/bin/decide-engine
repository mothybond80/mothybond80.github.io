#!/bin/sh
# Thin launcher so the engine runs from a plain checkout or plugin install with no pip install.
# Standard library only; python3 >= 3.11 required. -I isolates from cwd/user site-packages.
HERE="$(cd "$(dirname "$0")" && pwd)"
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from decide_engine.cli import main; sys.exit(main())' "$HERE/../engine" "$@"
